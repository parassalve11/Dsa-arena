# Copy to .env.local and fill in.
# Username you sign in with
AUTH_USERNAME=
# bcrypt hash from: npm run hash-password -- "your password"  (escape each $ as \$)
AUTH_PASSWORD_HASH=
# Random string, 32+ characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
